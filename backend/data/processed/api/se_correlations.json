      "strong": "0.6-0.8",
      "very_strong": "> 0.8"
    },
    "hypothesis_check": "Each computed correlation is compared to the indicator's hypothesized sign for that crime group; 'confirmed' if same sign and significant, 'contradicted' if opposite sign and significant, else 'inconclusive'."
  },
  "ethical_constraints": {
    "ecological_fallacy": "All relationships are DISTRICT-level (ecological). A district-level correlation does NOT license any inference about individuals. Never use these to profile a person, group, or community.",
